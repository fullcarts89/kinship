# Public, client-side settings for development builds (`npx expo start`).
# Committed on purpose: every value here ships inside the app anyway.
#  - The Supabase anon key is public; Row Level Security protects the data.
#  - The Sentry DSN is a public ingestion key; events are scrubbed on device.
# Secrets never go here (no service-role key, no Anthropic key, no auth tokens).
# A personal .env.development.local or .env.local overrides these.
#
# Note: this points development at the production Supabase project (Kinship
# has a single project). The Phase 0 device test needs exactly that.

EXPO_PUBLIC_SUPABASE_URL=https://kddpxiiyxgvjrtpdkvio.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImtkZHB4aWl5eGd2anJ0cGRrdmlvIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NzIxOTUyNTcsImV4cCI6MjA4Nzc3MTI1N30.x99wG7gF34mvKVJDRF8LcyqTbArqlaUcmoEEof4Q2Es
EXPO_PUBLIC_SENTRY_DSN=https://5b8f839512cd7473429c416c9780ab8b@o4512185268371456.ingest.us.sentry.io/4512185274531840

# Product analytics stay off until the PostHog review (F0-D4).
EXPO_PUBLIC_ANALYTICS_ENABLED=
