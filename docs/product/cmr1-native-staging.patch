+# CMR-1 native journeys on an EAS-hosted iOS simulator (docs/product/cmr1-native-staging.md).
+#
+# Manual dispatch only. It builds the app for the simulator with the `e2e-staging` profile (eas.json),
+# pointed at the RC's Supabase preview branch, then drives the three Maestro flows against that build.
+# Nothing here touches production: the Supabase URL and anon key come in as inputs at dispatch time
+# (never committed), and the accounts are staging-only test accounts (e2e/make-staging-account.mjs).
+#
+# Dispatch (from a checkout of claude/cmr1-rc or claude/cmr1-native-staging, after the founder's yes;
+# every run spends EAS build minutes and Maestro minutes on the account's plan):
+#
+#   EXPO_TOKEN=… npx eas-cli workflow:run .eas/workflows/cmr1-native.yml --non-interactive \
+#     -F supabase_url=https://<branch-ref>.supabase.co -F supabase_anon_key=<the branch's anon key> \
+#     -F e2e_email=<fresh account A> -F e2e_password=<…> \
+#     -F journey_email=<fresh account B> -F journey_password=<…>
+#
+# Order of the flows: the CMR-1 journey first (self-contained: its own fresh account, people added by
+# name), then the permanent fresh-install gate (needs a never-used account AND a simulator contact
+# "Maya Okafor" with a birthday within 14 days — not present on an EAS simulator unless seeded; see the
+# doc), then smoke-tell on the account fresh-install finished setting up.
+#
+# Voice cannot be driven here (no microphone, SFSpeechRecognizer unavailable on a simulator): the voice
+# scenarios stay with the founder's device pass.
+name: CMR-1 native journeys (staging simulator)
+
+on:
+  workflow_dispatch:
+    inputs:
+      supabase_url:
+        type: string
+        required: true
+        description: "The RC's Supabase preview branch API URL, https://<branch-ref>.supabase.co. Never production (kddpxiiyxgvjrtpdkvio)."
+      supabase_anon_key:
+        type: string
+        required: true
+        description: "That preview branch's anon (publishable) key. Production's key is refused by the build step below."
+      e2e_email:
+        type: string
+        required: true
+        description: "Fresh-install gate account (never used; no notebook_deck). Also smoke-tell's account afterwards."
+      e2e_password:
+        type: string
+        required: true
+        description: "Its password."
+      journey_email:
+        type: string
+        required: true
+        description: "CMR-1 journey account (never used; notebook_deck, tell, ai_extraction, memory_v2, shell_v2 on)."
+      journey_password:
+        type: string
+        required: true
+        description: "Its password."
+
+jobs:
+  build_ios_simulator:
+    name: Build iOS simulator (e2e-staging)
+    type: build
+    params:
+      platform: ios
+      profile: e2e-staging
+    env:
+      # The profile carries no Supabase target on purpose: it comes from the dispatch inputs.
+      EXPO_PUBLIC_SUPABASE_URL: ${{ inputs.supabase_url }}
+      EXPO_PUBLIC_SUPABASE_ANON_KEY: ${{ inputs.supabase_anon_key }}
+
+  maestro_journeys:
+    name: Maestro journeys (CMR-1, fresh-install gate, smoke-tell)
+    needs: [build_ios_simulator]
+    type: maestro
+    params:
+      build_id: ${{ needs.build_ios_simulator.outputs.build_id }}
+      flow_path:
+        - .maestro/cmr1-journey.yaml
+        - .maestro/fresh-install.yaml
+        - .maestro/smoke-tell.yaml
+    env:
+      E2E_EMAIL: ${{ inputs.e2e_email }}
+      E2E_PASSWORD: ${{ inputs.e2e_password }}
+      E2E_PERSON: Maya Okafor
+      E2E_JOURNEY_EMAIL: ${{ inputs.journey_email }}
+      E2E_JOURNEY_PASSWORD: ${{ inputs.journey_password }}
