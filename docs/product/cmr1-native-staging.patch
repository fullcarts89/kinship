@@ -0,0 +1,45 @@
+// Makes a test account on a Supabase PREVIEW BRANCH for the EAS-hosted simulator run (never production):
+// email + password printed once and written to the gitignored e2e/.captured/staging-account.<ref>.local.json,
+// the dogfood flags on for this account alone through user_flag_overrides (`--notebook`: notebook_deck too;
+// `--voice`: voice_capture too). Nothing is seeded into the account: no people, memories or reasons.
+//
+//   STAGING_API_URL=https://<branch-ref>.supabase.co STAGING_SERVICE_ROLE_KEY=<the branch's service role key> \
+//     node e2e/make-staging-account.mjs --notebook
+//
+// The branch ref and key come from the Supabase dashboard with that branch selected (Settings › API), or
+// `npx supabase --experimental branches get <git-branch> -o env`. The production ref is refused.
+import { Buffer } from "node:buffer";
+import { randomUUID } from "node:crypto";
+import { mkdirSync, writeFileSync } from "node:fs";
+
+const PRODUCTION_REF = "kddpxiiyxgvjrtpdkvio";
+const url = (process.env.STAGING_API_URL ?? "").replace(/\/+$/u, "");
+const key = process.env.STAGING_SERVICE_ROLE_KEY ?? "";
+const m = url.match(/^https:\/\/([a-z]{20})\.supabase\.co$/u);
+if (!m) throw new Error("STAGING_API_URL must be https://<branch-ref>.supabase.co");
+const ref = m[1];
+if (ref === PRODUCTION_REF) throw new Error("that is production; this script is for a preview branch only");
+if (!key) throw new Error("STAGING_SERVICE_ROLE_KEY is required (the branch's own key, never production's)");
+if (key.includes(`"ref":"${PRODUCTION_REF}"`) || Buffer.from(key.split(".")[1] ?? "", "base64").toString().includes(PRODUCTION_REF)) {
+  throw new Error("that service role key belongs to production");
+}
+
+const h = { apikey: key, authorization: `Bearer ${key}`, "content-type": "application/json" };
+const email = `staging-${randomUUID().slice(0, 8)}@kinship.test`;
+const password = `pw-${randomUUID()}`;
+const res = await fetch(`${url}/auth/v1/admin/users`, { method: "POST", headers: h, body: JSON.stringify({ email, password, email_confirm: true }) });
+const user = await res.json();
+if (!res.ok || !user?.id) throw new Error(`could not create the user: ${res.status} ${JSON.stringify(user)}`);
+
+// The flags the dogfood accounts have (cmr1-handoff.md §1), for this account only; every flag stays off
+// by default and at rollout 0 for everyone else (contract §10).
+const keys = ["shell_v2", "memory_v2", "tell", "ai_extraction", "relationship_page_v2",
+  ...(process.argv.includes("--notebook") ? ["notebook_deck"] : []),
+  ...(process.argv.includes("--voice") ? ["voice_capture"] : [])];
+const over = await fetch(`${url}/rest/v1/user_flag_overrides`, { method: "POST", headers: h, body: JSON.stringify(keys.map((flag_key) => ({ user_id: user.id, flag_key, enabled: true }))) });
+if (!over.ok) throw new Error(`flag overrides failed: ${over.status} ${await over.text()}`);
+
+mkdirSync(new URL("./.captured/", import.meta.url), { recursive: true });
+writeFileSync(new URL(`./.captured/staging-account.${ref}.local.json`, import.meta.url), JSON.stringify({ ref, email, password, id: user.id, flags: keys }, null, 2));
+console.log(`staging account ready on ${ref}: ${email} (flags: ${keys.join(", ")})`);
+console.log(`credentials in e2e/.captured/staging-account.${ref}.local.json (gitignored)`);
