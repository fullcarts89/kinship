# Supabase — Get these from your project's Settings > API page
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIs...

# ─── AI signal boosting (optional) ──────────────────────────────────────────
# Production: deploy supabase/functions/ai-insight and set its secret:
#   supabase functions deploy ai-insight
#   supabase secrets set ANTHROPIC_API_KEY=sk-ant-...
# The app routes through the edge function automatically when Supabase is
# configured — no key in the app bundle.
#
# DEV ONLY: to try AI in Expo Go without a backend, set a key below.
# EXPO_PUBLIC_ vars are embedded in the app bundle — NEVER set this for a
# release build.
# EXPO_PUBLIC_ANTHROPIC_API_KEY=sk-ant-...
# EXPO_PUBLIC_AI_MODEL=claude-opus-4-8
