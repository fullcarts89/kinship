# Supabase — Get these from your project's Settings > API page
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIs...

# ─── AI signal boosting (optional) ──────────────────────────────────────────
# Production: apply supabase/migrations/20261001090000_ai_usage.sql first (the per-user
# quota table; without it the function refuses every call), then deploy
# supabase/functions/ai-insight and set its secret:
#   supabase functions deploy ai-insight      # leave JWT verification on
#   supabase secrets set ANTHROPIC_API_KEY=sk-ant-...
# The function serves signed-in users only (the anon key alone gets 401) and
# allows each user AI_DAILY_LIMIT calls per UTC day before answering 429.
# Optional function secrets:
#   supabase secrets set AI_DAILY_LIMIT=50    # default 50
#   supabase secrets set AI_MODEL=claude-opus-4-8
#   supabase secrets set AI_ALLOWED_ORIGINS=https://app.example.com
#     ^ CORS allow-list, comma-separated. Only a web build needs it; the
#       native app makes no CORS requests. Unset = no browser origins.
# The app routes through the edge function automatically when Supabase is
# configured — no key in the app bundle.
#
# DEV ONLY: to try AI in Expo Go without a backend, set a key below.
# EXPO_PUBLIC_ vars are embedded in the app bundle — NEVER set this for a
# release build.
# EXPO_PUBLIC_ANTHROPIC_API_KEY=sk-ant-...
# EXPO_PUBLIC_AI_MODEL=claude-opus-4-8

# Crash reporting (OBS-05). Leave empty to send nothing. Events are scrubbed
# on the device (src/platform/crashScrubber.ts) before they are sent.
# Source-map upload is off in eas.json (SENTRY_DISABLE_AUTO_UPLOAD) until the
# Sentry project exists; then add organization/project to the
# "@sentry/react-native" plugin in app.json and SENTRY_AUTH_TOKEN as an EAS secret.
EXPO_PUBLIC_SENTRY_DSN=

# Product analytics (F0-D4; see docs/ops/analytics.md). Off unless
# EXPO_PUBLIC_ANALYTICS_ENABLED is exactly "true" and a key is set.
EXPO_PUBLIC_ANALYTICS_ENABLED=
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
